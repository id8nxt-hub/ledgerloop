{
  "name": "ledgerloop",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic Indian SaaS invoicing and payments app. The Issue to Impact sandbox.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream run dev",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:invoicing": "node --test tests/money.test.ts tests/invoice.test.ts tests/credit-note.test.ts",
    "test:api": "node --test tests/api.test.ts",
    "test:reconciliation": "node --test tests/reconciliation.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
